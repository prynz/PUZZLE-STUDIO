{
  "name": "@puzzle-studio/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "setup-skia-web public && expo start --web",
    "export:web": "setup-skia-web public && expo export --platform web",
    "export:native": "expo export --platform android --platform ios",
    "typecheck": "tsc --noEmit",
    "doctor": "pnpm dlx expo-doctor@latest",
    "test": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@puzzle-studio/image-processing": "workspace:*",
    "@puzzle-studio/ui": "workspace:*",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  }
}
